{
    "name": "rushing/laravel-inference",
    "description": "A vendor-neutral structured-generation substrate: a Prism-free StructuredLlm port plus its envelope value objects (GenerationRequest, GenerationResult, RawSchema, Usage) and a plain vanilla Prism::structured() binding. A consumer wires its own Prism/keys and reuses the shape; a platform may rebind a metered binding over the same port. The metering moat never enters this package (splicewire-app ADR-0125, amends ADR-0023; relocated to the rushing vendor by ADR-0205).",
    "keywords": ["laravel", "inference", "structured-generation", "prism", "llm"],
    "license": "proprietary",
    "authors": [
        {
            "name": "Stephen Rushing",
            "email": "stephenr85@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/contracts": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "prism-php/prism": "^0.100.1"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.0",
        "wikimedia/composer-merge-plugin": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "Rushing\\Inference\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Rushing\\Inference\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Rushing\\Inference\\InferenceServiceProvider"
            ]
        },
        "merge-plugin": {
            "include": ["composer.local.json"]
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "wikimedia/composer-merge-plugin": true
        },
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "pint": "@php -d memory_limit=512M vendor/bin/pint",
        "test": "@php vendor/bin/phpunit"
    }
}
